<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/bar"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <EditText
            android:id="@+id/url"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/on_bar"
            android:textColorHint="@color/on_bar_dim"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/btn_video"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Detected videos">

            <ImageView
                android:id="@+id/video_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:alpha="0.45"
                android:src="@drawable/ic_video" />

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_ubo"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="uBlock Origin">

            <ImageView
                android:id="@+id/ubo_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                android:tint="@color/ubo_red" />

            <TextView
                android:id="@+id/ubo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:textColor="@color/on_bar_dim"
                android:textSize="9sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tabs">

            <TextView
                android:id="@+id/tab_count"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tabcount"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_bar"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
